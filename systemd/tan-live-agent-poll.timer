# tan-live-agent paper poll timer — runs every 15 minutes.
# Independent of tan-live.service. Produces shadow advisor output only.

[Unit]
Description=Run tan-live-agent paper poll every 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
