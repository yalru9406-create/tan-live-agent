# tan-live-agent advisor HTTP service (stage 2).
# Always-on so paper_engine (separate venv) can call POST /gate, /params.
# Consumes fcc quota ONLY when paper_engine actually calls it
# (TAN_ADVISOR_PAPER=1); idle service costs nothing.

[Unit]
Description=tan-live-agent advisor HTTP service (stage 2 paper-engine integration)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/hermes-os/tan-live-agent
EnvironmentFile=/root/.hermes/secrets/consolidated.env
Environment=TAN_AGENT_MODEL_BACKEND=fcc
Environment=TAN_AGENT_JOURNAL=/srv/hermes-os/tan-live-agent/data/advisor_journal.sqlite3
ExecStart=/srv/hermes-os/tan-live-agent/.venv/bin/tan-live-agent serve --host 127.0.0.1 --port 8090
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
